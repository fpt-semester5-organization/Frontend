# ==============================================================================
# VeggieLife Frontend - Environment Variables (Example Template)
# ==============================================================================

# Đường dẫn gốc API (dùng qua Vite proxy khi dev hoặc URL trực tiếp)
VITE_API_BASE_URL=/api/v1

# Địa chỉ Server Backend ASP.NET Core (được Vite proxy chuyển tiếp /api -> VITE_PROXY_TARGET)
VITE_PROXY_TARGET=http://localhost:5137

# Cổng khởi chạy máy chủ Frontend Vite khi dev (3000)
VITE_PORT=3000

# Khóa xác thực Google OAuth Client ID (đăng nhập Google)
VITE_GOOGLE_CLIENT_ID=

# Khóa API Google Maps (tìm kiếm nhà hàng / địa điểm thuần chay)
VITE_GOOGLE_MAPS_API_KEY=

# Chế độ Mock dữ liệu: false = gọi Backend thật, true = bật dữ liệu giả lập (chỉ dev)
VITE_MOCK_AUTH=false
VITE_ENABLE_MOCKS=false
