# API Base URL (default connects to local backend or Vite proxy)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth Client ID for Guest/Member authentication
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Maps API Key for nearby vegetarian venues (HappyCow + Maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
